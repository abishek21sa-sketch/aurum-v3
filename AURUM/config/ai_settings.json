{
  "ai_enabled": true,
  "fallback_to_cached_artifacts": true,
  "fallback_to_rules": true,
  "max_llm_calls_per_run": 2,
  "default_model": "gpt-4o-mini",
  "low_cost_model": "gpt-4o-mini",
  "timeout_seconds": 20,
