    "provider": "openai",
    "enabled_by_default": false,
    "requires_explicit_external_approval": true,
    "requires_managed_api_key": true,
    "model_output_must_be_grounded": true
  },
  "evaluation": {
    "contract_checks_required": true,
    "execution_authorization_from_ai": false,
    "research_promotion_from_ai": false,
    "live_provider_smoke_test_requires_operator": true,
    "live_evaluation_requires_explicit_flag": true,
    "live_evaluation_flag": "AURUM_AI_RUN_LIVE_EVAL"
  },
  "phase5b": {
    "enabled": true,
    "committee_mode": "single_call",
    "use_compressed_context": true,
    "use_cached_on_quota_error": true,
    "portfolio_manager_mode": "included",
    "max_agent_count": 5,
    "run_rebuttals": true,
    "run_votes": true
  },
  "phase5c": {
    "enabled": true,
    "use_llm": false
  }
