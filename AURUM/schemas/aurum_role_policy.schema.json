{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurum.local/schemas/aurum_role_policy.schema.json",
  "title": "AURUM Declarative Role Policy Contract",
  "type": "object",
  "required": ["schema_version", "policy_type", "enforcement_note", "roles", "required_controls"],
  "properties": {
    "schema_version": {"type": "string"},
    "policy_type": {"const": "DECLARATIVE_ROLE_CAPABILITY_CONTRACT"},
    "enforcement_note": {"type": "string", "minLength": 1},
    "roles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["allow", "deny"],
        "properties": {
          "allow": {"type": "array", "items": {"type": "string"}},
          "deny": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "required_controls": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": true
}
