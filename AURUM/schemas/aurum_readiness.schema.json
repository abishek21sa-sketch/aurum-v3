{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurum.local/schemas/aurum_readiness.schema.json",
  "title": "AURUM Enterprise Readiness Contract",
  "type": "object",
  "required": [
    "schema_version",
    "service",
    "build_mode",
    "overall_status",
    "release_gate",
    "decision_id",
    "research_promotion",
    "execution_enabled",
    "checks",
    "summary",
    "artifact_inventory",
    "audit_lineage",
    "role_policy"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "generated_at_utc": {"type": "string"},
    "service": {"type": "string"},
    "build_mode": {"const": "OFFLINE_FIRST_RESEARCH"},
    "overall_status": {"enum": ["READY_FOR_HUMAN_REVIEW", "NOT_READY"]},
    "release_gate": {"enum": ["PASS", "FAIL"]},
    "decision_id": {"type": "string"},
    "optimization_authorization": {"enum": ["AUTHORIZED", "BLOCKED"]},
    "research_promotion": {"const": "RESEARCH_ONLY"},
    "execution_enabled": {"const": false},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check_id", "domain", "status", "severity", "summary", "details"],
        "properties": {
          "check_id": {"type": "string"},
          "domain": {"type": "string"},
          "status": {"enum": ["PASS", "FAIL"]},
          "severity": {"enum": ["INFO", "HIGH", "CRITICAL"]},
          "summary": {"type": "string"},
          "details": {"type": "object"}
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["total_checks", "passed_checks", "failed_checks", "critical_failures"],
      "properties": {
        "total_checks": {"type": "integer", "minimum": 0},
        "passed_checks": {"type": "integer", "minimum": 0},
        "failed_checks": {"type": "integer", "minimum": 0},
        "critical_failures": {"type": "integer", "minimum": 0}
      }
    },
    "artifact_inventory": {"type": "array"},
    "audit_lineage": {
      "type": "object",
      "required": ["schema_version", "hash_algorithm", "root_hash", "nodes"],
      "properties": {
        "schema_version": {"type": "string"},
        "hash_algorithm": {"const": "SHA-256"},
        "root_hash": {"type": "string", "minLength": 1},
        "nodes": {"type": "array", "minItems": 1}
      }
    },
    "role_policy": {"type": "object"}
  },
  "additionalProperties": true
}
