{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurum.local/schemas/aurum_sbom.schema.json",
  "title": "AURUM CycloneDX Software Bill of Materials",
  "type": "object",
  "required": ["bomFormat", "specVersion", "serialNumber", "version", "metadata", "components"],
  "properties": {
    "bomFormat": {"const": "CycloneDX"},
    "specVersion": {"const": "1.5"},
    "serialNumber": {"type": "string", "pattern": "^urn:uuid:"},
    "version": {"const": 1},
    "metadata": {
      "type": "object",
      "required": ["component", "properties"],
      "properties": {
        "component": {"type": "object", "required": ["type", "name"]},
        "properties": {"type": "array", "minItems": 1}
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "group", "name", "version", "purl"],
        "properties": {
          "type": {"const": "library"},
          "group": {"const": "pypi"},
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "purl": {"type": "string", "pattern": "^pkg:pypi/"}
        }
      }
    }
  },
  "additionalProperties": true
}
