{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurum.local/schemas/aurum_customer_evidence.schema.json",
  "title": "AURUM Customer Evidence Intake",
  "type": "object",
  "required": ["schema_version", "service", "status", "coverage", "controls", "manifest_schema_valid"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "service": {"const": "AURUM customer evidence intake"},
    "generated_at_utc": {"type": "string"},
    "status": {"enum": ["EVIDENCED", "REQUIRED"]},
    "coverage": {"$ref": "#/$defs/coverage"},
    "controls": {"type": "array", "minItems": 5, "items": {"type": "object", "required": ["control_id", "label", "owner", "status"], "properties": {"control_id": {"type": "string"}, "label": {"type": "string"}, "owner": {"type": "string"}, "status": {"enum": ["EVIDENCED", "REQUIRED"]}, "evidence_uri": {"type": ["string", "null"]}, "evidence_sha256": {"type": ["string", "null"]}, "approved_by": {"type": ["string", "null"]}, "approved_at_utc": {"type": ["string", "null"]}, "verification_record": {"type": ["string", "null"]}}, "additionalProperties": false}},
    "manifest_present": {"type": "boolean"},
    "manifest_schema_valid": {"type": "boolean"},
    "source": {"type": "string"},
    "manifest_path": {"type": "string"},
    "claim_boundary": {"type": "string"}
  },
  "$defs": {"coverage": {"type": "object", "required": ["passed", "total", "percent"], "properties": {"passed": {"type": "integer", "minimum": 0}, "total": {"type": "integer", "minimum": 0}, "percent": {"type": "number", "minimum": 0, "maximum": 100}}, "additionalProperties": false}},
  "additionalProperties": false
}
